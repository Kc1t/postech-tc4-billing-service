    {
      "name": "Webhook Mercado Pago",
      "item": [
        {
          "name": "Notificação assinada",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-request-id",
                "value": "{{xRequestId}}"
              },
              {
                "key": "x-signature",
                "value": "{{xSignature}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/webhooks/mercadopago?data.id={{mpPaymentId}}&type=payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "webhooks",
                "mercadopago"
              ],
              "query": [
                {
                  "key": "data.id",
                  "value": "{{mpPaymentId}}"
                },
                {
                  "key": "type",
                  "value": "payment"
                }
              ]
            },
            "description": "Com o segredo certo (variável webhookSecret = MP_WEBHOOK_SECRET) devolve 200; o serviço relê GET /v1/payments/{id} no Mercado Pago antes de mudar o estado. Assinatura inválida → 401.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"payment.updated\",\n  \"api_version\": \"v1\",\n  \"type\": \"payment\",\n  \"data\": {\n    \"id\": \"{{mpPaymentId}}\"\n  },\n  \"live_mode\": false\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Assina como o Mercado Pago: HMAC-SHA256 do manifest id:{data.id};request-id:{x-request-id};ts:{ts};",
                  "const dataId = pm.collectionVariables.get('mpPaymentId').toLowerCase();",
                  "const requestId = pm.variables.replaceIn('{{$guid}}');",
                  "const ts = Date.now().toString();",
                  "const manifest = `id:${dataId};request-id:${requestId};ts:${ts};`;",
                  "const v1 = CryptoJS.HmacSHA256(manifest, pm.collectionVariables.get('webhookSecret')).toString(CryptoJS.enc.Hex);",
                  "pm.variables.set('xRequestId', requestId);",
                  "pm.variables.set('xSignature', `ts=${ts},v1=${v1}`);"
                ]
              }
            }
          ]
        },
        {
          "name": "Notificação sem assinatura (401)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/webhooks/mercadopago?data.id={{mpPaymentId}}&type=payment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "webhooks",
                "mercadopago"
              ],
              "query": [
                {
                  "key": "data.id",
                  "value": "{{mpPaymentId}}"
                },
                {
                  "key": "type",
                  "value": "payment"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"payment\",\n  \"data\": {\n    \"id\": \"{{mpPaymentId}}\"\n  }\n}"
