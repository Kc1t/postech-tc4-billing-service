# Copie para .env (lido automaticamente em desenvolvimento). Valores abaixo = padrões locais.

# Aplicação
APP_PORT=8082
# prod: exige JWT_SECRET próprio e mensageria configurada
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=20s
READINESS_TIMEOUT=2s

# Observabilidade (sem licença o agente fica desligado e o serviço funciona normalmente)
NEW_RELIC_APP_NAME=billing-service
NEW_RELIC_LICENSE_KEY=

# Banco (migrations aplicadas na subida)
POSTGRES_DSN=postgres://postgres:postgres@localhost:5434/billing?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m

# Autenticação e CORS
# o mesmo do os-service e da Lambda de autenticação
JWT_SECRET=change-me-in-production
# lista separada por vírgula; "*" é recusado
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AWS / LocalStack (sem fila e tópico o serviço sobe só com a API HTTP)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
SQS_BILLING_COMMANDS_URL=http://localhost:4566/000000000000/billing-commands
SNS_BILLING_EVENTS_ARN=arn:aws:sns:us-east-1:000000000000:billing-events
OUTBOX_POLL_INTERVAL=500ms

# Fault injection: com true, o campo simulate_failure dos comandos força budget/payment a falhar
FAULT_INJECTION_ENABLED=false

# Gateway de pagamento: fake (local/demo) ou mercadopago
PAYMENT_GATEWAY=fake
FAKE_CHECKOUT_BASE_URL=http://localhost:8082

# Mercado Pago (obrigatórios com PAYMENT_GATEWAY=mercadopago; use credenciais de TESTE)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_NOTIFICATION_URL=https://<api-gateway>/billing/api/v1/webhooks/mercadopago
MP_BASE_URL=https://api.mercadopago.com
MP_TIMEOUT=5s
MP_PREFERENCE_TTL=24h
# >0 recusa notificações com ts fora da janela (anti-replay)
MP_WEBHOOK_MAX_AGE=0s
